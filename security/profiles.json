{
  "909094292": {
    "repository": "noelnovo/WalletTracker",
    "repository_id": "909094292",
    "targets": ["dev", "main"],
    "events": ["pull_request", "push"],
    "adapter": "android",
    "instance": "instance-005",
    "roles": {
      "pull_request": "security-ci-android-pr-reusable",
      "push": "security-ci-android-push-reusable"
    },
    "status_prefix": "security/sonarqube-dtrack-",
    "analysis_group": "wallettracker-security-analysis",
    "sources": "app/src/main,ci,scripts",
    "sonar_properties": {
      "sonar.tests": "app/src/test,tests",
      "sonar.java.binaries": "app/build",
      "sonar.exclusions": "**/__pycache__/**,ci/test_*.py",
      "sonar.coverage.jacoco.xmlReportPaths": "app/build/reports/jacoco/jacocoTestReport/jacocoTestReport.xml",
      "sonar.coverage.exclusions": "app/src/main/java/win/downops/wallettracker/ui/**,app/src/main/java/win/downops/wallettracker/MainActivity.kt,app/src/main/java/win/downops/wallettracker/v2/WalletActivity.kt,app/src/main/java/win/downops/wallettracker/v2/BillEditor.kt,app/src/main/java/win/downops/wallettracker/v2/WalletDesign.kt"
    },
    "build_args": {}
  },
  "864547743": {
    "repository": "noelnovo/nn-PortFolio",
    "repository_id": "864547743",
    "targets": ["main"],
    "instance": "instance-002",
    "role": "security-ci-portfolio-pr-reusable",
    "sources": "src,ci,Dockerfile",
    "coverage_sources": ["ci/patch-next-vendors.mjs", "ci/runtime-smoke.cjs"],
    "sonar_properties": {
      "sonar.javascript.lcov.reportPaths": "coverage/lcov.info",
      "sonar.test.inclusions": "ci/test_*.py,ci/test_*.cjs",
      "sonar.exclusions": "**/__pycache__/**,ci/test_*.py,ci/test_*.cjs"
    },
    "build_args": {}
  },
  "1406330066": {
    "repository": "noelnovo/dev-blog",
    "repository_id": "1406330066",
    "targets": ["dev", "main"],
    "instance": "instance-003",
    "role": "security-ci-blog-pr-reusable",
    "sources": "assets,layouts,ci,Dockerfile",
    "build_args": {
      "dev": {"HUGO_BASEURL": "https://blog.int.downops.win/"},
      "main": {"HUGO_BASEURL": "https://blog.noelnovo.dev/"}
    }
  }
}
